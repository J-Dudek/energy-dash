# https://editorconfig.org : les éditeurs et les formateurs (Spotless, Prettier) partent des mêmes règles.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_size = 4
max_line_length = 100

[*.{xml,properties}]
indent_size = 4

[*.ts]
max_line_length = 100

[*.md]
trim_trailing_whitespace = false
