# Copier en .env (jamais commité) puis remplir.

# --- Gaz de Bordeaux (identifiants de espaceclient.gazdebordeaux.fr) ---
CONSO_GDB_ENABLED=true
CONSO_GDB_EMAIL=
CONSO_GDB_PASSWORD=

# --- Iléo (identifiants de www.mel-ileo.fr, espace perso) ---
CONSO_ILEO_ENABLED=true
CONSO_ILEO_EMAIL=
CONSO_ILEO_PASSWORD=

# --- Netatmo (temps de chauffe de la chaudière, thermostat + relais) ---
# 1. Crée une application sur https://dev.netatmo.com/apps (récupère client_id et client_secret)
# 2. Dans cette application, "Token generator" avec le droit read_thermostat : copie le refresh token
# Le jeton tourne à chaque collecte : le collecteur le garde dans un fichier (volume Docker "collector-data").
# Pour en refaire un, remplace simplement CONSO_NETATMO_REFRESH_TOKEN : il prend le pas sur le fichier.
CONSO_NETATMO_ENABLED=false
CONSO_NETATMO_CLIENT_ID=
CONSO_NETATMO_CLIENT_SECRET=
CONSO_NETATMO_REFRESH_TOKEN=
# Facultatif : sinon le premier thermostat NATherm1 du compte est utilisé
# CONSO_NETATMO_DEVICE_ID=   (MAC du relais)
# CONSO_NETATMO_MODULE_ID=   (MAC du thermostat)
# Type de mesure getmeasure du temps de marche de la chaudière (en secondes)
# CONSO_NETATMO_MEASURE_TYPE=sum_boiler_on
# Historique relu à chaque collecte, en jours (1000 max : Netatmo plafonne à 1024 valeurs par appel)
# CONSO_NETATMO_LOOKBACK_DAYS=1000

# --- Appwrite ---
# Endpoint vu par le collecteur (réseau interne du NAS possible, ex. http://192.168.1.10:8080/v1)
CONSO_APPWRITE_ENDPOINT=https://appwrite.byj6n.fr/v1
# Endpoint vu par le navigateur (doit être joignable depuis tes appareils)
CONSO_APPWRITE_PUBLIC_ENDPOINT=https://appwrite.byj6n.fr/v1
CONSO_APPWRITE_PROJECT_ID=
# Clé API serveur, scopes : databases.read/write, tables.read/write, columns.read/write,
# rows.read/write, buckets.read/write, files.read/write
CONSO_APPWRITE_API_KEY=
CONSO_APPWRITE_DATABASE_ID=conso
CONSO_APPWRITE_BUCKET_ID=invoices
# Qui peut lire les données : "user:<id>" ou "team:<id>" (recommandé), ou "users" (tout compte du projet :
# à n'utiliser qu'après avoir fermé l'inscription libre dans la console Appwrite). Réappliqué à chaque démarrage.
CONSO_APPWRITE_READ_ROLE=user:REMPLACER_PAR_TON_USER_ID

# --- Planification ---
# Cron Spring (secondes minutes heures jour mois jour-semaine), heure de Paris
CONSO_CRON=0 17 6 * * *
CONSO_RUN_ON_STARTUP=true

# --- Notifications (nouvelle facture) sur Android et iPhone ---
# Génère les clés une fois : node scripts/generate-vapid-keys.mjs  (voir docs/notifications.md)
# La clé publique est partagée avec le dashboard ; la clé privée ne quitte jamais le collecteur.
# Vide = notifications désactivées.
# CONSO_VAPID_PUBLIC_KEY=
# CONSO_VAPID_PRIVATE_KEY=
# Contact exigé par les services de push (Apple le vérifie) : mailto:toi@exemple.fr ou https://ton-site
# CONSO_PUSH_SUBJECT=mailto:
# Alerte de consommation : notification quand un mois d'électricité ou de gaz dépasse le même mois de l'an dernier
# d'au moins N % (25 par défaut, 0 = pas d'alerte). Nécessite les notifications ci-dessus.
# CONSO_ALERT_THRESHOLD_PCT=25

# --- Session du dashboard (garde-fous côté navigateur) ---
# Déconnexion après N minutes sans activité, et durée maximale d'une session quelle que soit l'activité.
# La durée de vie réelle de la session se règle aussi côté Appwrite : voir "Sécurité" dans le README.
# CONSO_SESSION_IDLE_MINUTES=30
# CONSO_SESSION_MAX_HOURS=12

# --- Exposition du dashboard ---
# Par défaut le dashboard n'écoute qu'en local (127.0.0.1) : il est joignable via le reverse proxy HTTPS.
# CONSO_DASHBOARD_BIND=127.0.0.1
